#!/usr/bin/env bash
export JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home"
export PATH="$JAVA_HOME/bin:$PATH"

MVN_BIN="/Users/themacstore/.m2/wrapper/dists/apache-maven-3.9.16/56ba1f9f/bin/mvn"
if [ ! -f "$MVN_BIN" ]; then
    MVN_BIN=$(find /Users/themacstore/.m2/wrapper/dists -name "mvn" 2>/dev/null | head -n 1)
fi
if [ -n "$MVN_BIN" ] && [ -x "$MVN_BIN" ]; then
    exec "$MVN_BIN" "$@"
else
    exec mvn "$@"
fi
